{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "study-planner": {
      "root": "study-planner",
      "framework": "express"
    },
    "client": {
      "root": "study-planner/client",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "study-planner"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "client"
      }
    }
  ]
}
